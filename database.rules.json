{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('role').val() === 'owner' && root.child('users').child(auth.uid).child('pensionId').val() === root.child('users').child($uid).child('pensionId').val()))",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'network_admin')"
      }
    },

    "pensions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'network_admin'",

      "$pensionId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || root.child('users').child(auth.uid).child('pensionId').val() === $pensionId)",

        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (!data.exists() && newData.child('ownerUid').val() === auth.uid))",

        "plan": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (!data.exists() && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        },
        "status": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (!data.exists() && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        },
        "accountCount": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('role').val() === 'owner' && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        },
        "trialEndsAt": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (!data.exists() && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        },
        "ownerUid": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (!data.exists() && auth.uid === newData.val()))"
        },
        "ownerEmail": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (!data.exists() && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        },
        "pensionName": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('pensionId').val() === $pensionId && root.child('users').child(auth.uid).child('role').val() === 'owner'))"
        },
        "createdAt": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (!data.exists() && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        },

        "members": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('role').val() === 'owner' && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        },

        "config": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('pensionId').val() === $pensionId && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'staff')))"
        },

        "reservations": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('pensionId').val() === $pensionId && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'staff')))",

          "$resId": {
            ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('pensionId').val() === $pensionId && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'staff'))) || (!data.exists() && newData.child('pendingConfirmation').val() === true && newData.child('source').val() === 'Site Rezervari'))"
          }
        },

        "supportChat": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('pensionId').val() === $pensionId && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'staff')))"
        },

        "$other": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'network_admin' || (root.child('users').child(auth.uid).child('role').val() === 'owner' && root.child('users').child(auth.uid).child('pensionId').val() === $pensionId))"
        }
      }
    },

    "bannedEmails": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'network_admin'"
    }
  }
}
